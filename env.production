# ============================================
# DATING APP — PRODUCTION ENVIRONMENT
# ============================================
# IMPORTANT: Replace all placeholder values with real production values
# NEVER commit this file to version control if it contains real secrets

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production

# ============================================
# SUPABASE CONFIGURATION
# ============================================
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
SUPABASE_JWT_SECRET=your-production-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://betold_user:your-secure-password@postgres:5432/betold
POSTGRES_USER=betold_user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=betold
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://:your-redis-password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ============================================
# BACKBLAZE B2 STORAGE
# ============================================
B2_APPLICATION_KEY_ID=your-production-b2-key-id
B2_APPLICATION_KEY=your-production-b2-key
B2_BUCKET_NAME=dating-app-production
B2_BUCKET_ID=your-production-bucket-id
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your-production-jwt-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_NAME=Dating App
APP_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
API_URL=https://api.yourdomain.com

# ============================================
# SECURITY CONFIGURATION
# ============================================
CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW_MS=900000
SESSION_DURATION_HOURS=12

# ============================================
# EMAIL/SMS CONFIGURATION
# ============================================
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# ============================================
# MONITORING
# ============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_KYC=true
FEATURE_VIP=true
FEATURE_REALTIME=true
FEATURE_NOTIFICATIONS=true