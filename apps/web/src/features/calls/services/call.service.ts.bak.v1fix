import { supabase } from '@/config/supabase.client';
import { CallSession, CallSignal } from '../types/call.types';
import type { RealtimeChannel } from '@supabase/supabase-js';

class CallService {
  /**
   * Persistent channel registry — one per callId.
   * Sending and receiving both go through the SAME channel instance,
   * otherwise Supabase Realtime broadcast will not deliver.
   */
  private channels = new Map<string, RealtimeChannel>();

  private async getOrCreateChannel(callId: string): Promise<RealtimeChannel> {
    const name = `call:session:${callId}`;
    let ch = this.channels.get(name);
    if (ch) return ch;
    ch = supabase.channel(name);
    await ch.subscribe();
    this.channels.set(name, ch);
    return ch;
  }

  async startCall(targetUserId: string): Promise<CallSession | null> {
    const { data, error } = await supabase.rpc('start_voice_call', {
      p_target_user_id: targetUserId,
    });

    if (error) {
      if (error.message.includes('busy')) {
        throw new Error('User is currently on another call');
      }
      if (error.message.includes('block')) {
        throw new Error('You cannot call this user');
      }
      if (error.message.includes('already')) {
        throw new Error('You are already in a call');
      }
      throw error;
    }

    if (data?.error === 'busy') {
      throw new Error('User is currently on another call');
    }

    return data as CallSession;
  }

  async updateCallStatus(callId: string, status: string): Promise<void> {
    await supabase.rpc('update_call_status', {
      p_call_id: callId,
      p_status: status,
    });
  }

  async endCall(callId: string, reason: string): Promise<void> {
    await supabase.rpc('end_voice_call', {
      p_call_id: callId,
      p_end_reason: reason,
    });
  }

  subscribeToIncomingCalls(userId: string, callback: (call: CallSession) => void): () => void {
    const channel = supabase
      .channel(`call:user:${userId}`)
      .on('postgres_changes', {
        event: 'INSERT',
        schema: 'public',
        table: 'call_sessions',
        filter: `callee_id=eq.${userId}`,
      }, (payload) => {
        callback(payload.new as CallSession);
      })
      .subscribe();

    return () => { supabase.removeChannel(channel); };
  }

  async subscribeToCallSignals(callId: string, callback: (signal: CallSignal) => void): Promise<() => void> {
    const ch = await this.getOrCreateChannel(callId);
    const handler = (payload: any) => callback(payload.payload as CallSignal);
    ch.on('broadcast', { event: 'call_signal' }, handler);
    // Return no-op cleanup — channel is released by releaseCallChannel()
    return () => { /* channel survives until endCall */ };
  }

  async sendCallSignal(callId: string, signal: CallSignal): Promise<void> {
    const ch = await this.getOrCreateChannel(callId);
    await ch.send({
      type: 'broadcast',
      event: 'call_signal',
      payload: signal,
    });
  }

  releaseCallChannel(callId: string): void {
    const name = `call:session:${callId}`;
    const ch = this.channels.get(name);
    if (ch) {
      supabase.removeChannel(ch);
      this.channels.delete(name);
    }
  }
}

export const callService = new CallService();
